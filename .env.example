HYPIXEL_API_KEY=your_hypixel_api_key_here

# --- Demo mode (optional) ---
# Set to 1/true to serve every page from static fixture files in demo/
# instead of calling the Hypixel API. Useful for offline development.
# When enabled, HYPIXEL_API_KEY is NOT required, rate limiting is bypassed,
# and any searched username resolves to the demo player fixture.
# Generate fixtures first with: node scripts/capture-demo.mjs <username>
# DEMO_MODE=false

# --- Rate limiting (all optional; defaults shown) ---
# Sliding window for the per-IP cap (ms). Default: 60000 (1 minute).
# RATE_LIMIT_PER_IP_WINDOW_MS=60000
# Max upstream API calls per IP per window. Default: 120.
# RATE_LIMIT_PER_IP_MAX=120
# Sliding window for the per-(IP, player) cap (ms). Default: 3600000 (1 hour).
# RATE_LIMIT_PLAYER_WINDOW_MS=3600000
# Max upstream API calls per (IP, player) per window. Default: 60.
# RATE_LIMIT_PLAYER_MAX=60
# Max distinct players per IP per window. Default: 120.
# RATE_LIMIT_DISTINCT_PLAYERS_PER_IP=120
# Master kill-switch: set to 1 or true to disable rate limiting entirely.
# RATE_LIMIT_DISABLED=false
